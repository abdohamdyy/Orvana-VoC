# Copy to .env and adjust. .env is git-ignored: credentials never go into the code or the repo.

# Local LLM (Ollama)
# use 127.0.0.1 rather than localhost (on Windows localhost adds ~2 s per request via IPv6 fallback)
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b

# Email. Locally this is Mailpit (no auth). For a real server set host/port/user/password + STARTTLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=voc-report@orvana.example
MAIL_TO=management@orvana.example

# Schedule (cron: minute hour day month day_of_week) in the given timezone
SCHEDULE_CRON=0 8 * * mon
TIMEZONE=Africa/Cairo
RUN_ON_START=true

# Business rules
DOUBLE_CHARGE_URGENT_EGP=1000
CASCADE_THRESHOLD=0.8
